# ============================================================
# Dreamy 部署配置模板
# 使用:复制为 .env.deploy 后填写(该文件已被 Git 忽略,不入库)
#   cp .env.deploy.example .env.deploy
#
# 变量生效方式:
#   运行时变量(地址/密钥/开关):改后 docker compose up -d 即生效
#   构建变量(NEXT_PUBLIC_* / VITE_*):改后需重跑 scripts/release.sh
# ============================================================

# ── 阿里云 ACR 镜像仓库(个人版·香港)────────────────────
# 开通后:控制台 → 容器镜像服务 → 个人实例 → 命名空间,把值填到这里
ACR_REGISTRY=registry.cn-hongkong.aliyuncs.com
ACR_NAMESPACE=
# 镜像 tag:latest=最新发布;git-<短SHA>=指定版本(回滚时改为旧版本 tag)
IMAGE_TAG=latest

# ── 公网访问地址(当前 IP:端口直连模式,替换 <服务器IP>)──
PUBLIC_STORE_URL=http://<服务器IP>:5173
PUBLIC_ADMIN_URL=http://<服务器IP>:5174
# 邀请链接/SEO 等对外基址(store 门户)
SITE_BASE_URL=http://<服务器IP>:5173

# ── 容器间内网地址(compose 内网互通,一般不需要改)────────
# 后端服务地址(store 反代/admin nginx/RSC 取数共用;注意不带尾斜杠)
BACKEND_INTERNAL_URL=http://backend:18081
DB_URL=jdbc:mysql://mysql:3306/identity?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
REDIS_HOST=redis
REDIS_PORT=6379

# ── 必需密钥(无默认值;后端启动 fail-fast 校验)──────────
# MySQL root 密码(首次启动初始化数据卷时生效,之后改值不会改库内密码)
MYSQL_ROOT_PASSWORD=
# identity 库应用连接密码(与 MYSQL_ROOT_PASSWORD 一致即可,root 直连)
DB_PASSWORD=
# 各 JWT 密钥至少 32 字节,且两者必须不同
STORE_JWT_SECRET=
ADMIN_JWT_SECRET=
# Base64 编码的稳定 32 字节 AES-256 密钥(若已有密文数据必须沿用原密钥)
DREAMY_GATEWAY_AES_KEY=
# newsletter 退订链接 HMAC 签名密钥,至少 32 字符(轮换即作废旧退订链接)
NEWSLETTER_UNSUBSCRIBE_SECRET=

# ── CORS 允许来源(同源反代模式下通常不触发,直连/跨域场景才需要)──
# 逗号分隔多值;默认分别为本地 dev 5173/5174
STORE_CORS_ORIGIN=http://<服务器IP>:5173
ADMIN_CORS_ORIGIN=http://<服务器IP>:5174

# ── 前端构建变量(改后需重跑 release.sh 重新构建镜像)────
NEXT_PUBLIC_SITE_URL=http://<服务器IP>:5173
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GA4_ID=
# 管理端"查看前台"跳转地址
VITE_STORE_BASE_URL=http://<服务器IP>:5173

# ── 业务模式开关(stub=内置模拟,零外部依赖;real 需配对应密钥)──
MQ_MODE=stub
STRIPE_MODE=stub
STORAGE_MODE=stub
MAIL_MODE=stub
GA4_MODE=stub
OIDC_MODE=real
# 演示数据:新环境首次启动置 true 灌入演示商品/内容,便于验收
DEMO_SEED_ENABLED=false

# ── 首个管理员(新环境首次启动创建;创建后即可置空)──────
DREAMY_BOOTSTRAP_ADMIN_EMAIL=
DREAMY_BOOTSTRAP_ADMIN_PASSWORD=

# ── 运行时杂项────────────────────────────────────────
TZ=Asia/Hong_Kong
# 注意:值含空格必须加引号(脚本以 shell source 方式加载本文件)
JAVA_OPTS="-Xms512m -Xmx1g"

# ── 宿主端口(默认与本地 dev 一致;端口冲突时覆盖,如本地验证)──
# BACKEND_PORT=18081
# STORE_PORT=5173
# ADMIN_PORT=5174
# MYSQL_PORT=3306
