# 边缘网关:唯一对外入口,三个端口分别转发到内网服务(宿主端口语义与直暴模式完全一致,
# 对外地址/CORS/CSP 均不变;上域名+HTTPS 时仅需改本网关配置)。
# 上游地址由环境变量注入(默认 compose 服务名,与 DB_URL 的 mysql:3306 同为编排层契约)。
# 注意 Host 用 $http_host 原样透传(含端口):$host 丢端口会让后端把同源 POST 误判为跨域。

server {
    listen 5173;
    server_name _;

    location / {
        proxy_pass ${STORE_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket 升级(通用透传,生产 store 不依赖但无害)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
        client_max_body_size 20m;
    }
}

server {
    listen 5174;
    server_name _;

    # 整体转发到 admin 应用容器(其自带 nginx 承担静态托管与 /api 反代)
    location / {
        proxy_pass ${ADMIN_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        client_max_body_size 20m;
    }
}

server {
    listen 18081;
    server_name _;

    # 后端 API 直通(webhook/OIDC 回调/直连调试)
    location / {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        client_max_body_size 20m;
    }
}
