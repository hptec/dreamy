# ============================================================
# dreamy-server(Rust)本地开发环境变量模板
# 使用:cp .env.example .env 后 cargo run(docker compose 场景由编排注入,无需本文件)
# 完整密钥复用仓库根 .env.deploy(DB_PASSWORD/STORE_JWT_SECRET/ADMIN_JWT_SECRET 等)
# ============================================================

# ── 监听端口 ──
SERVER_HTTP_PORT=18082
SERVER_GRPC_PORT=18083

# ── 数据库(主库 dreamy_server + 次库 identity 共享表)──
SERVER_DB_HOST=localhost
SERVER_DB_PORT=3306
SERVER_DB_NAME=dreamy_server
SERVER_DB_LEGACY_NAME=identity
DB_USERNAME=root
DB_PASSWORD=

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT 密钥(与 Java 共享;≥32 字节且两者不同;P2 起必填)──
STORE_JWT_SECRET=
ADMIN_JWT_SECRET=

# ── 邮件(Resend;缺省 stub 模式不外发,P2 生效)──
RESEND_API_KEY=
RESEND_FROM=noreply@dreamy.com

# ── CORS(dev 前端来源)──
STORE_CORS_ORIGIN=http://localhost:5173
ADMIN_CORS_ORIGIN=http://localhost:5174

# ── 杂项 ──
TZ=Asia/Hong_Kong
RUST_LOG=dreamy_server=debug,info
