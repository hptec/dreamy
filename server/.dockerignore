# 构建上下文瘦身:target 仅保留 musl 交叉编译产物(见 Dockerfile build-arg BINARY)
target/*
!target/x86_64-unknown-linux-musl
target/x86_64-unknown-linux-musl/*
!target/x86_64-unknown-linux-musl/release
target/x86_64-unknown-linux-musl/release/*
!target/x86_64-unknown-linux-musl/release/dreamy-server
!target/aarch64-unknown-linux-musl
target/aarch64-unknown-linux-musl/*
!target/aarch64-unknown-linux-musl/release
target/aarch64-unknown-linux-musl/release/*
!target/aarch64-unknown-linux-musl/release/dreamy-server
openapi.yaml
.env
